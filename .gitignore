.venv/
__pycache__/
*.pyc
.mypy_cache/

# Downloaded and generated data. Anyone can rebuild it from the manifest,
# so it does not belong in git.
data/raw/
data/work/
dist/

# Keep the manifests, drop the rest of data/interim.
# The /* matters: without it git skips the whole directory and never sees
# the line below.
data/interim/*
!data/interim/manifest*.csv
ai-lab_docs/
